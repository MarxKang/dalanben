# 复制此文件为 keystore.properties 并填写你自己的发布签名信息
# （keystore.properties 已被 .gitignore 排除，不会进入代码仓库）
# 生成自己的签名：keytool -genkey -v -keystore dalanben.keystore -alias dalanben -keyalg RSA -keysize 2048 -validity 10000
storeFile=dalanben.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=dalanben
keyPassword=YOUR_KEY_PASSWORD
